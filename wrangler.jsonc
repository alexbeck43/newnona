{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newnona",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0894e274-1b92-4941-a5c8-1a8a9e0d8dc1","database_name": "newnona" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "915e16d75661453bbd6f0cd88c0d2086" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
